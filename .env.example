# Copie para .env.local e preencha os valores reais. Nunca versione segredos.
# Desenvolvimento funciona sem SMTP; mensagens de teste ficam em .data/outbox.
SITE_URL=http://127.0.0.1:3000
ALLOW_INDEXING=false

# Canais oficiais, opcionais. Links só são exibidos quando preenchidos.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FOUNDER_NAME=

# SMTP do Gmail: STARTTLS obrigatório na porta 587.
# Ative a verificação em duas etapas e gere uma senha de app:
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Preencha com a senha de app do Google, não com a senha de login.
SMTP_PASS=
MAIL_FROM=
# Destinatário das notificações de contato (não é exposto no navegador).
CONTACT_EMAIL=

# Persistência: deixe vazio para usar .data/ na pasta do projeto.
# Em hospedagem, precisa ser um volume privado e persistente.
PORTFOLIO_DATA_DIR=
# Só habilite se o proxy confiável sobrescrever X-Forwarded-For.
PORTFOLIO_TRUST_PROXY=false
# Duas etapas: obrigatórias para Admin em produção; opcional antecipar localmente.
PORTFOLIO_REQUIRE_ADMIN_MFA=false
# Em desenvolvimento, a chave é gerada em .data/.encryption-key quando necessária.
# Em produção, use a mesma chave privada de 32 bytes na migração; nunca publique.
PORTFOLIO_ENCRYPTION_KEY=
PORTFOLIO_BACKUP_DIR=
PORTFOLIO_BACKUP_MIRROR_DIR=
PORTFOLIO_BACKUP_RETENTION=14
